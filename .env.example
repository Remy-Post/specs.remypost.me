# Copy to .env (never commit it). On the VM this lives at /home/ubuntu/specs/.env.

# Bearer token the n8n workflow sends to /api/v1/ingest. At least 32 characters; generate with:
#   openssl rand -hex 24
# If it is unset or shorter, ingest answers 503 and stores nothing.
INGEST_TOKEN=

# SQLite file. The Docker image mounts the specs_data volume at /data.
SPECS_DB_PATH=/data/specs.db

# --- Oracle VM sampler (src/lib/vm). All optional; the defaults are the container's mounts (compose.yml). ---
# Set to "off" to not sample at all (tests, or a machine that is not the VM). On a Mac /proc does not exist and the
# sampler just logs once and publishes nothing.
#SPECS_VM_SAMPLER=off
# Where the sampler reads from. Point these at fixture folders to try the VM view on a laptop.
#SPECS_HOST_PROC=/proc
#SPECS_HOST_CGROUP=/host/cgroup
#SPECS_HOST_NETDEV=/host/net/dev
#SPECS_HOST_RUN=/host/run
#SPECS_HOST_DISK=/data
# Instance metadata (shape and region, read once at start). "off" skips it.
#SPECS_IMDS_URL=http://169.254.169.254/opc/v2/instance
# Most open event streams at once (GET /api/v1/stream); more get 503.
#SPECS_MAX_STREAMS=200
# Most streams per visitor (Cf-Connecting-Ip); more get 429. No header, no per-visitor cap.
#SPECS_MAX_STREAMS_PER_CLIENT=6
# A stream ends itself after this long (plus up to 30 s of jitter) and the browser reconnects.
#SPECS_STREAM_MAX_MS=600000
